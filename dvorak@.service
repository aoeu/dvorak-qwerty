[Unit]
Description=Dvorak Virtual Keyboard (%i)

[Service]
ExecStart=/usr/local/bin/dvorak -d /dev/input/%i
# If the device disappears (unplug, suspend) the process exits cleanly.
# udev will fire a new 'add' event on resume/replug and start a fresh instance.
Restart=no
StandardOutput=null
StandardError=journal
